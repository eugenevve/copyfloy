{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@app/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@package": ["./package.json"]
    }
  },
  "include": ["src/preload/index.d.ts", "src/preload/api.ts", "src/renderer/**/*.ts", "src/renderer/**/*.tsx", "./src/shared/**/*"]
}
